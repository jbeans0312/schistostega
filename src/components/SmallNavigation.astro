---
import '../styles/global.css'

const {showBack=true, showHome=false, showBlog=false, showContact=false, page, class: className} = Astro.props;
const isPostSidebarNavigation = className === 'post-sidebar-navigation';

const backLinkMap = new Map<string, string>();
backLinkMap.set("blog", "../");
backLinkMap.set("contact", "../");
backLinkMap.set("a-post", "../");
backLinkMap.set("b-post", "../");
---
<style>
    div {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        max-height:min-content;
        margin-top: 0.75rem;
        padding-top: 0px;
        flex-wrap: wrap;
    }
    h1, h3 {
        min-width: 25px;
        text-align: center;
        margin-block: 0;
    }
</style>
<div class={className}>
    {showBack && <h3 id="blog-post-nav" style={isPostSidebarNavigation ? 'font-size: 1.2rem' : undefined}><a id="nav" href={backLinkMap.get(page)}><span style={isPostSidebarNavigation ? 'font-family: Chapbook; font-size: 1.3rem' : 'font-family: Chapbook;'}>C </span>back</a></h3> <h3 id="blog-post-nav">|</h3>}
    {showHome && <h3 id="blog-post-nav" style={isPostSidebarNavigation ? 'font-size: 1.2rem' : undefined}><a id="nav" href="../../"><span style={isPostSidebarNavigation ? 'font-family: Chapbook; font-size: 1.3rem' : 'font-family: Chapbook;'}>c </span>home</a></h3>}
    {showBlog && <h3 id="blog-post-nav"> </h3> <h3 id="blog-post-nav"><a id="nav" href="../blog"><span style="font-family: Chapbook;">V </span>blog</a></h3>}
    {showContact && <h3 id="blog-post-nav"> </h3> <h3 id="blog-post-nav"><a id="nav" href="../contact"><span style="font-family: Chapbook;">L </span>contact</a></h3>}
</div>