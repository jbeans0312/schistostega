---
import '../styles/global.css'
import Head from '../components/Head.astro';
import Headline from "../components/Headline.astro";
import EntriesPage from '../layouts/EntriesPage.astro';
import ContentWrapper from "../components/ContentWrapper.astro";
import SmallNavigation from '../components/SmallNavigation.astro';
import { getCollection } from 'astro:content'

const thumbnails = import.meta.glob<string>(
	'../content/blog/images/thumbnails/final/*.webp',
	{ eager: true, query: '?url', import: 'default' }
);
const thumbnailByName = Object.fromEntries(
	Object.entries(thumbnails).map(([path, url]) => [path.split('/').pop(), url])
);
const fallbackThumbnail = thumbnailByName['goblin-lanterns-helen-hyde-1906.webp'];

const posts = (await getCollection('blog')).sort(
  (b, a) => {
    const dateA = a.data.updated_date ? a.data.updated_date.valueOf() : a.data.published_date.valueOf();
    const dateB = b.data.updated_date ? b.data.updated_date.valueOf() : b.data.published_date.valueOf();
    return dateA - dateB;
  }
);
---
<style>
	h1 {
		margin-bottom: 5px;
		margin-top:0px;
	}
	.blog-entry {
		margin-bottom: 2rem;
	}
	.blog-entry:first-child {
		padding-top: 0.75rem;
	}
	.blog-entry:not(:last-child) {
		border-bottom: 1px solid var(--text-color);
		padding-bottom: 1.5rem;
	}

	.blog-thumbnail-link {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 1;
		overflow: hidden;
		margin-bottom: 0.75rem;
		position: relative;
		isolation: isolate;
	}

	.blog-thumbnail-link::after {
		content: '';
		position: absolute;
		inset: 0;
		background-color: color-mix(in srgb, var(--highlight-color) 70%, transparent);
		mix-blend-mode: color;
		opacity: 0;
		transition: opacity 180ms ease;
		pointer-events: none;
	}

	.blog-thumbnail {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.blog-thumbnail-link:hover::after,
	.blog-thumbnail-link:focus-visible::after {
		opacity: 1;
	}
	.blog-page-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 14rem;
		gap: 2rem;
		align-items: start;
		max-width: 1100px;
		margin: 0 auto;
		padding-inline: 1rem;
	}
	.blog-sidebar {
		position: sticky;
		top: 1rem;
		min-width: 0;
		border-left: 1px solid var(--text-color);
		padding-left: 1rem;
	}
	.blog-sidebar-image {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 1rem;
	}
	.sidebar-heading {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.sidebar-heading span {
		font-family: Chapbook;
		color: var(--text-color);
	}
	.sidebar-heading h2 {
		margin: 0;
		font-size: 1.1rem;
	}
	.blog-sidebar ul {
		list-style: none;
		padding-left: 0;
	}
	.blog-sidebar li {
		margin-block: 0.5rem;
	}
	@media (max-width: 800px) {
		.blog-page-layout {
			grid-template-columns: minmax(0, 1fr);
			padding-inline: 0.5rem;
		}
		.blog-sidebar {
			display: none;
		}
	}
</style>
<html lang="en">
	<Head title="blog"></Head>
	<body>
		<Headline title={"SCHISTOSTEGA"}></Headline>
		<SmallNavigation page="blog" showBack={false} showHome showContact></SmallNavigation>
		<div class="blog-page-layout">
			<ContentWrapper class="post-main">
				{
					posts.map(post => (
						<div class="blog-entry" id={post.id}>
							<a class="blog-thumbnail-link" href={`/blog/${post.id}`} aria-label={`Read ${post.data.title}`}>
								<img
									class="blog-thumbnail"
									src={thumbnailByName[post.data.thumbnail ?? ''] ?? fallbackThumbnail}
									alt=""
									loading="lazy"
								/>
							</a>
							<h1><a id="nav" href={`/blog/${post.id}`}>{post.data.title}</a></h1>
							<strong id="blog-date">{post.data.updated_date ? post.data.updated_date.toLocaleDateString() : post.data.published_date.toLocaleDateString()}</strong>
							<p id="blog-desc">{post.data.description}</p>
						</div>
					))
				}
			</ContentWrapper>
			<aside class="blog-sidebar" aria-label="Blog sidebar">
				<img class="blog-sidebar-image" src="/schistostega-fox.webp" alt="" />
				<nav aria-label="Blog posts">
					<div class="sidebar-heading"><span>a</span><h2>Posts</h2></div>
					<ul>
						{posts.map(post => (
							<li><a href={`/blog/${post.id}`}>{post.data.title}</a></li>
						))}
					</ul>
				</nav>
			</aside>
		</div>
	</body>
</html>
