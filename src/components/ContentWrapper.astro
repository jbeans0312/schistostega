---
import '../styles/global.css';
import '@fontsource/montserrat'
const { class: className } = Astro.props;
---
<style>
    #content-wrapper{
    border-style: solid;
    border-color: var(--text-color);
    padding: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-width: 2px;
    margin-left: 18em;
    margin-right: 18em;
    margin-top: 0px;
    }

    /* Medium screens */
    @media (max-width: 1024px) {
    #content-wrapper {
        margin-left: 5em;
        margin-right: 5em;
    }
    }

    /* Small screens */
    @media (max-width: 768px) {
    #content-wrapper {
        margin-left: 1.5em;
        margin-right: 1.5em;
    }
    }

    /* Very small screens */
    @media (max-width: 520px) {
    #content-wrapper {
        margin-left: 0.2em;
        margin-right: 0.2em;
    }
    }
    #content-wrapper.post-main {
        margin: 0;
        padding-top: 0;
    }
</style>
<div id="content-wrapper" class={className}>
    <slot />
</div>